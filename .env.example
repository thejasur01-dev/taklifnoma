# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
# Publishable key (or legacy "anon" key) — safe for the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (or legacy "service_role" key) — SERVER ONLY, bypasses RLS.
SUPABASE_SECRET_KEY=

# Supabase CLI: personal access token + database password (db push, gen types).
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Phone login codes via Telegram Gateway (gateway.telegram.org → API token).
TELEGRAM_GATEWAY_TOKEN=
# Local development only: accept code 000000 without Gateway. Ignored in production.
AUTH_DEV_FIXED_CODE=

# Allow publishing without payment (test activation button) outside development.
# Keep empty in production once Payme/Click are live.
ALLOW_FREE_PUBLISH=

# Telegram bot for customer notifications (BotFather) — stage 5.
TELEGRAM_BOT_TOKEN=

# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for auth redirects and Telegram widget callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
# Publishable key (or legacy "anon" key) — safe for the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (or legacy "service_role" key) — SERVER ONLY, bypasses RLS.
SUPABASE_SECRET_KEY=

# Telegram (BotFather). Login widget needs `/setdomain` → your public domain (not localhost).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# Supabase CLI personal access token (for db push / gen types). Dashboard → Account → Access Tokens.
SUPABASE_ACCESS_TOKEN=
